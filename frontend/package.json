{
  "name": "oasify",
  "version": "1.0.0",
  "description": "AI-powered application builder platform. Chat with AI to build full-stack applications, get instant previews, and deploy to production with one click.",
  "keywords": [
    "ai",
    "builder",
    "nextjs",
    "aws",
    "typescript",
    "tailwind",
    "development",
    "deployment"
  ],
  "author": "Oasify",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/oasify.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/oasify/issues"
  },
  "homepage": "https://github.com/your-username/oasify#readme",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "bash ./scripts/factory-dev.sh",
    "dev:raw": "next dev --turbopack",
    "factory:dev": "bash ./scripts/factory-dev.sh",
    "lint": "next lint",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "infra:plan": "cd ../infra/terraform && terraform plan",
    "infra:apply": "cd ../infra/terraform && terraform apply"
  },
