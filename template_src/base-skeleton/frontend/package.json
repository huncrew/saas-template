    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^0.539.0",
    "next": "15.4.6",
    "next-themes": "^0.4.6",
    "react": "19.1.4",
    "react-dom": "19.1.4",
    "react-hook-form": "^7.62.0",
    "sonner": "^2.0.7",
    "stripe": "^18.4.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.76"
