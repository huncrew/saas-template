{
  "name": "simple-saas-template",
  "version": "1.0.0",
  "description": "A minimal, production-ready SaaS starter template built with Next.js, AWS, and Stripe. Perfect for AI-focused applications with subscription management and modern UI.",
  "keywords": [
    "saas",
    "template",
    "nextjs",
    "aws",
    "stripe",
    "ai",
    "typescript",
    "tailwind"
  ],
  "author": "Simple SaaS Template",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/simple-saas-template.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/simple-saas-template/issues"
  },
  "homepage": "https://github.com/your-username/simple-saas-template#readme",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev --turbopack",
    "lint": "next lint",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "infra:plan": "cd ../infra/terraform && terraform plan",
    "infra:apply": "cd ../infra/terraform && terraform apply"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.864.0",
